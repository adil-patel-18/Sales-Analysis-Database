CREATE DATABASE sales_db;


CREATE TABLE sales (
    order_id SERIAL PRIMARY KEY,
    customer_name VARCHAR(50),
    product VARCHAR(50),
    category VARCHAR(30),
    quantity INT,
    price DECIMAL(10,2),
    order_date DATE,
    city VARCHAR(50)
);


